# Local-only published quotation preview. The browser stays on localhost;
# this proxy supplies the canonical brand hostname that identifies a release.
server {
    listen 80;
    server_name _;

    location ^~ /_next/ {
        proxy_pass http://host.docker.internal:8115;
        proxy_set_header Host ${PUBLICATION_PREVIEW_HOSTNAME};
        proxy_set_header X-Forwarded-Host ${PUBLICATION_PREVIEW_HOSTNAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(en|vi|ar)/q/[^/]+(?:/|$) {
        proxy_pass http://host.docker.internal:8115;
        proxy_set_header Host ${PUBLICATION_PREVIEW_HOSTNAME};
        proxy_set_header X-Forwarded-Host ${PUBLICATION_PREVIEW_HOSTNAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /media/ {
        proxy_pass http://host.docker.internal:8115;
        proxy_set_header Host ${PUBLICATION_PREVIEW_HOSTNAME};
        proxy_set_header X-Forwarded-Host ${PUBLICATION_PREVIEW_HOSTNAME};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /favicon.ico {
        proxy_pass http://host.docker.internal:8115;
        proxy_set_header Host ${PUBLICATION_PREVIEW_HOSTNAME};
        proxy_set_header X-Forwarded-Host ${PUBLICATION_PREVIEW_HOSTNAME};
    }

    # Do not turn this loopback proxy into an editor/API ingress.
    location / { return 404; }
}

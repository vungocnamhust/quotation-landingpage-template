server {
    listen 80 default_server;
    server_name _;

    # Public brand hosts are database-resolved by Next/FastAPI. They may serve
    # only public React quotation and media paths; no editor/API fallback.
    location ~ ^/(en|vi|ar)/q/[^/]+/ {
        proxy_pass http://quote-generator:8115;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(en|vi|ar)/q/[^/]+$ {
        proxy_pass http://quote-generator:8115;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, s-maxage=300, stale-while-revalidate=86400" always;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /media/ {
        proxy_pass http://quote-generator:8115;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The public brochure's Leaflet client loads tiles through this narrowly
    # scoped Next.js route; do not broaden this to a general /api/ proxy.
    location ^~ /api/map-tiles/ {
        proxy_pass http://quote-generator:8115;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / { return 404; }
}

server {
    listen 80;
    server_name ${PUBLIC_FALLBACK_HOSTNAME};

    # Customer fallback host: it may render only an active public release and
    # its release-scoped media. Never let this host fall through to staff/API.
    location ~ ^/p/[^/]+/ {
        proxy_pass http://quote-generator:8115;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;

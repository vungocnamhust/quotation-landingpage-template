# Environment (local | production)
ENVIRONMENT=production

# Application URL
APP_BASE_URL=https://quote.capellatravel.com
PUBLIC_BASE_URL=https://quote.capellatravel.com

# DMC Core API service base URL (for webhook callbacks)
DMC_CORE_URL=https://your-dmc-core-url

# OpenAI API key — used by image_selector.py to map locations to province slugs
OPENAI_API_KEY=sk-your-openai-key-here

# GitHub Personal Access Token (Settings > Developer settings > PAT > Fine-grained)
GITHUB_TOKEN=ghp_your_github_pat_here
GITHUB_REPO=vungocnamhust/quotation-landingpage-template

# DeepSeek API Configuration (compatible with PydanticAI)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Postgres configuration
# Change this password! It must match the one in docker-compose.yml
POSTGRES_PASSWORD=change_me_to_a_secure_password
DATABASE_URL=postgresql+asyncpg://quotation:${POSTGRES_PASSWORD}@postgres:5432/quotation
DATABASE_URL_SYNC=postgresql+psycopg://quotation:${POSTGRES_PASSWORD}@postgres:5432/quotation
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Cloudflare R2 Credentials
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=quotation-v2
R2_REGION=auto
R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# Public Base URL for displaying images
# e.g., https://cdn.capellatravel.com or https://pub-xxxxxx.r2.dev
R2_PUBLIC_BASE_URL=https://cdn.example.com

# Media processing configuration
MEDIA_SYNC_DIR=/data/media-sync/inbox
MEDIA_CACHE_DIR=/data/media-sync/cache
MEDIA_PREVIEW_MAX_WIDTH=480
MEDIA_PREVIEW_MAX_HEIGHT=320
MEDIA_PREVIEW_QUALITY=82
# Choose exactly one editor identity boundary. In direct mode, Cloudflare
# Access JWT is verified by FastAPI. In gateway mode, Nginx calls DMC and only
# accepts the identity headers returned by that auth subrequest.
DMC_GATEWAY_ENABLED=false
DMC_AUTH_PROXY_URL=
QUOTE_TRUST_CLOUDFLARE_ACCESS_HEADERS=false

# A fresh V2 production database is required. The Compose migrate service
# aborts when pre-existing quotation rows are detected.
V2_PRODUCTION_FRESH_START=true

# Outer Nginx allowlist. Keep this in sync with active brands and Cloudflare
# custom-hostname enrollment; FastAPI/Next still validate brands.status at run time.
PUBLIC_BRAND_HOSTS=journeys.capellatravel.com my.selvarajourneys.com journeys.vietnamsafar.vn

# Internal Next.js/worker-to-FastAPI authentication. Never expose this value in NEXT_PUBLIC_*.
QUOTE_SERVICE_TOKEN=replace_me

# Durable V2 publication worker. Values are safe defaults and can be tuned
# without code changes.
PUBLICATION_JOB_MAX_ATTEMPTS=5
PUBLICATION_JOB_BACKOFF_BASE_SECONDS=30
PUBLICATION_JOB_BACKOFF_MAX_SECONDS=900
PUBLICATION_JOB_LEASE_SECONDS=300
PUBLICATION_WORKER_POLL_SECONDS=2

# Direct Cloudflare Access mode validates the signed JWT before admitting an
# editor request. Set both when QUOTE_TRUST_CLOUDFLARE_ACCESS_HEADERS=true.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace_with_access_application_aud

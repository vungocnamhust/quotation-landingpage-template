# OpenAI API key — used by image_selector.py to map locations to province slugs
OPENAI_API_KEY=sk-your-openai-key-here

# GitHub Personal Access Token (Settings > Developer settings > PAT > Fine-grained)
# Permissions needed: Contents (read & write)
GITHUB_TOKEN=ghp_your_github_pat_here

# GitHub repo in format "owner/repo"
GITHUB_REPO=vungocnamhust/quotation-landingpage-template

# Public base URL of this app on Vercel (no trailing slash)
PUBLIC_BASE_URL=https://your-project.vercel.app

# Environment (local | production)
ENVIRONMENT=local

# DMC Core API service base URL (for webhook callbacks)
DMC_CORE_URL=http://localhost:8000

# DeepSeek API Configuration (compatible with PydanticAI)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Postgres configuration for quotation v2 storage
DATABASE_URL=postgresql+asyncpg://quotation:quotation_password@postgres:5432/quotation
DATABASE_URL_SYNC=postgresql+psycopg://quotation:quotation_password@postgres:5432/quotation
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Operations business day for booking deadlines, penalties, and business codes.
OPS_TIMEZONE=Asia/Ho_Chi_Minh

# Cloudflare R2 and media processing
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=quotation-v2
R2_REGION=auto
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_DEV_ENDPOINT=https://pub-your-dev-endpoint.r2.dev
R2_PUBLIC_BASE_URL=https://cdn.example.com
MEDIA_SYNC_DIR=/data/media-sync/inbox
MEDIA_CACHE_DIR=/data/media-sync/cache
MEDIA_PREVIEW_MAX_WIDTH=480
MEDIA_PREVIEW_MAX_HEIGHT=320
MEDIA_PREVIEW_QUALITY=82

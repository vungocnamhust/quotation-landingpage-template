ENVIRONMENT=production
POSTGRES_PASSWORD=quotation-regression-password
DATABASE_URL=postgresql+asyncpg://quotation:quotation-regression-password@postgres:5432/quotation
DATABASE_URL_SYNC=postgresql+psycopg://quotation:quotation-regression-password@postgres:5432/quotation
QUOTE_AUTH_REQUIRED=false
QUOTE_SERVICE_TOKEN=regression-service-token
DMC_GATEWAY_ENABLED=false
QUOTE_TRUST_CLOUDFLARE_ACCESS_HEADERS=true
CLOUDFLARE_ACCESS_TEAM_DOMAIN=team.example.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=regression-audience
PUBLIC_BRAND_HOSTS=journeys.example.com
PUBLIC_FALLBACK_HOSTNAME=quotes.example.com
R2_ACCESS_KEY_ID=regression-access-key
R2_SECRET_ACCESS_KEY=regression-secret-key
R2_BUCKET=quotation-v2
R2_REGION=us-east-1
R2_ENDPOINT=http://minio.invalid
R2_PUBLIC_BASE_URL=http://minio.invalid/quotation-v2
